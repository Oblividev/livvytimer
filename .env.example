# ===========================================
# Livvy Timer - Environment Configuration
# ===========================================
# Copy this file to .env and fill in the values.
# See README.md for detailed setup instructions.

# --- Twitch Configuration ---
# Get these from https://dev.twitch.tv/console
TWITCH_CLIENT_ID=your_client_id_here
TWITCH_CLIENT_SECRET=your_client_secret_here
TWITCH_ACCESS_TOKEN=your_oauth_token_here

# The broadcaster's Twitch user ID (numeric)
# Find it at: https://www.streamweasels.com/tools/convert-twitch-username-to-user-id/
TWITCH_BROADCASTER_ID=your_broadcaster_id_here

# --- Streamlabs Configuration ---
# Get your Socket API Token from:
# https://streamlabs.com/dashboard#/settings/api-settings
STREAMLABS_SOCKET_TOKEN=your_streamlabs_socket_token_here

# --- Server Configuration ---
PORT=3000
